# mindlm-mcp configuration — every variable below is OPTIONAL.
# Without any of them the tool runs in zero-key mode (heuristic outline in the
# CLI, client-model refinement in MCP).
#
# This file is only an example. Copy it to `.env` and pass it explicitly with
# `--env-file .env`; nothing is loaded automatically.

# ---------------------------------------------------------------------------
# LLM (optional). Set a key to switch `--mode auto` over to real model calls.
# ---------------------------------------------------------------------------
# anthropic | openai — leave empty to auto-detect from whichever key is set.
MINDMAP_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint, e.g. a self-hosted or third-party gateway.
# Defaults to https://api.openai.com/v1 when only OPENAI_API_KEY is set.
OPENAI_BASE_URL=
# Model name. Optional for anthropic (defaults to claude-sonnet-5); REQUIRED for
# openai-compatible endpoints, where no name is portable across providers.
MINDMAP_LLM_MODEL=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Default directory for exported HTML files (defaults to ./mindmaps).
MINDMAP_OUTPUT_DIR=
# Set to true to let url_to_mindmap reach loopback/private addresses.
MINDMAP_ALLOW_PRIVATE_HOSTS=false
# Hard cap on characters accepted from any single input.
MINDMAP_MAX_INPUT_CHARS=200000
# Cap on the cleaned source text handed back to the client model.
MINDMAP_CLIENT_MAX_CHARS=60000
